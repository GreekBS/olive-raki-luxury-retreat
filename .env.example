# Talos Direct Booking (server-only — never expose to the browser)
# Production base URL for the Talos Direct Booking API (no trailing slash)
TALOS_DIRECT_BOOKING_API_URL=https://talos-jade.vercel.app

# Opaque property-scoped Direct Booking key (dbk_test_… or dbk_live_…)
# Never commit the real value. Never prefix with NEXT_PUBLIC_.
TALOS_DIRECT_BOOKING_KEY=

# Optional: Origin sent to Talos for allowlist checks (defaults to https://oliveandraki.gr)
# TALOS_DIRECT_BOOKING_ORIGIN=https://oliveandraki.gr
